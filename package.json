{
  "name": "personal-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace of personal, provider-independent Pi extensions",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "pi": {
    "extensions": [
      "./packages/activity-indicator/index.js",
      "./packages/code-intelligence/index.js",
      "./packages/graphite-ui/index.js",
      "./packages/session-compaction/index.js",
      "./packages/web/index.js",
      "./packages/ui-check/index.js",
      "./packages/subagents/index.js",
      "./packages/background-tasks/index.js",
      "./packages/ask-user/index.js"
    ],
    "themes": [
      "./packages/graphite-ui/themes/graphite.json"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "check:pi": "node scripts/check-pi-compat.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typebox": "catalog:",
    "typescript": "catalog:"
  }
}
