{
  "name": "@clement_chsn/pi-web",
  "version": "0.1.0",
  "description": "Brave web search, local reading of pages, PDFs, images and GitHub URLs, and versioned Context7 documentation for Pi.",
  "license": "MIT",
  "author": "Clément CHESNEAU",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clementchesneau/pi-extensions.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/clementchesneau/pi-extensions/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/clementchesneau/pi-extensions/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@clement_chsn/pi-shared": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "@upstash/context7-sdk": "0.4.1",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "turndown": "7.2.4",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "typebox": "catalog:"
  }
}
